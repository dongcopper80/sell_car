{
  "name": "otochinhchu-platform",
  "version": "1.0.0",
  "description": "OtoChinhChu platform: web + CMS + API for mobile app (NestJS + PostgreSQL)",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "seed": "node dist/database/seeds/seed.js",
    "migration:generate": "typeorm-ts-node-esm migration:generate -d src/database/data-source.ts",
    "migration:create": "typeorm-ts-node-esm migration:create -d src/database/data-source.ts",
    "migration:run": "typeorm-ts-node-esm migration:run -d src/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-esm migration:revert -d src/database/data-source.ts",
    "migration:show": "typeorm-ts-node-esm migration:show -d src/database/data-source.ts",
    "db:schema:v1": "psql -h %DB_HOST% -U %DB_USER% -d %DB_NAME% -f src/database/sql/v1_schema.sql",
    "db:dump": "pg_dump -h %DB_HOST% -U %DB_USER% -d %DB_NAME% --data-only --inserts -f src/database/sql/v1_data_dump.sql",
    "db:restore": "psql -h %DB_HOST% -U %DB_USER% -d %DB_NAME% -f src/database/sql/v1_full_restore.sql",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\""
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.2.10",
    "@nestjs/swagger": "^7.1.16",
    "@nestjs/throttler": "^5.0.1",
    "@nestjs/typeorm": "^10.0.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "helmet": "^7.1.0",
    "multer": "^1.4.5-lts.1",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.24"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.10.3",
    "@types/passport-jwt": "^3.0.13",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.6"
  }
}
