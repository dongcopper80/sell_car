  menu: '<path d="M4 6h16M4 12h16M4 18h16"></path>',
  file: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"></path><path d="M14 2v6h6M8 13h8m-8 4h8"></path>',
  chart: '<path d="M4 19V5m0 14h17M8 15l3-4 3 2 5-7"></path>',
  layers: '<path d="m12 2 9 5-9 5-9-5 9-5Z"></path><path d="m3 12 9 5 9-5M3 17l9 5 9-5"></path>',
  car: '<path d="M5 17a2 2 0 1 0 4 0 2 2 0 0 0-4 0Zm10 0a2 2 0 1 0 4 0 2 2 0 0 0-4 0Z"></path><path d="M3 13l2-5a2 2 0 0 1 1.8-1.2h10.4A2 2 0 0 1 19 8l2 5v4h-2M3 13v4h2m-2-4h18m-14 4h10"></path>',
  home: '<path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1Z"></path>',
  bell: '<path d="M18 8a6 6 0 1 0-12 0c0 7-3 8-3 8h18s-3-1-3-8"></path><path d="M13.7 21a2 2 0 0 1-3.4 0"></path>',
  settings: '<circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33h.08a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z"></path>',
  trash: '<path d="M3 6h18M8 6V4h8v2m-9 0 1 14h8l1-14"></path>',
  edit: '<path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path>',
};
const icon = (n) => `<span class="icon" aria-hidden="true"><svg viewBox="0 0 24 24">${iconPaths[n] || iconPaths.arrow}</svg></span>`;

async function api(path, opts = {}) {
  const res = await fetch(`${API_BASE}${path}`, {
    ...opts,
    headers: { 'Content-Type': 'application/json', ...(state.token ? { Authorization: `Bearer ${state.token}` } : {}), ...(opts.headers || {}) },
    body: opts.body ? JSON.stringify(opts.body) : undefined,
  });
  const json = await res.json().catch(() => ({}));
  if (!res.ok) throw new Error(json.message || json.code || 'L�i không xác định');
  return json.data ?? json;
}

const collectExternalPhotos = (v) => String(v || '').split(/[\n,]+/).map((x) => x.trim()).filter(Boolean);
const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&', '<': '<', '>': '>', '"': '"' }[c]));
const vnd = (n) => new Intl.NumberFormat('vi-VN').format(Number(n)) + ' ��';
const initials = (s) => (s || '?').split(' ').filter(Boolean).slice(-2).map((w) => w[0]).join('').toUpperCase();
const statusBadge = (s) => `<span class="status">${esc(String(s || '').replaceAll('_', ' '))}</span>`;
const statusClass = (s) => `status-${String(s).toLowerCase().replaceAll(' ', '-').replaceAll('_', '-')}`;

function toast(message, type = 'success') {
  document.querySelector('.toast-region')?.remove();
  const el = document.createElement('div');
  el.className = 'toast-region';
  el.innerHTML = `<div class="toast ${type === 'error' ? 'error' : ''}">${icon(type === 'error' ? 'close' : 'check')}<span>${esc(message)}</span></div>`;
  document.body.appendChild(el);
  setTimeout(() => el.remove(), 3200);
}

/* ---------- auth bootstrap (test mode) ---------- */
async function ensureTestSession() {
  if (!USE_TEST_MODE || state.token) return;
  try {
    const res = await api('/auth/login', { method: 'POST', body: TEST_ACCOUNT });
    state.token = res.accessToken; state.user = res.user;
    localStorage.setItem('aoto_token', res.accessToken);
    localStorage.setItem('aoto_user', JSON.stringify(res.user));
    localStorage.setItem('aoto_test_mode', '1');
  } catch (err) { console.warn('[test-mode] auto-login failed:', err.message); }
}

/* ---------- router ---------- */
const routes = {};
const route = (p, h) => (routes[p] = h);
const navigate = (h) => (location.hash = h);
async function render() {
  const [path, query] = (location.hash.slice(1) || '/').split('?');
  const params = new URLSearchParams(query || '');
  for (const pattern of Object.keys(routes)) {
    const names = pattern.match(/:[^/]+/g) || [];
    const m = path.match(new RegExp('^' + pattern.replace(/:[^/]+/g, '([^/]+)') + '$'));
    if (m) {
      const kwargs = {};
      names.forEach((n, i) => (kwargs[n.slice(1)] = decodeURIComponent(m[i + 1])));
      try { await routes[pattern](kwargs, params); }
      catch (e) { $('#app').innerHTML = webShell(`<div class="surface empty-state container"><div class="empty-icon">${icon('close')}</div><h3>Đã xảy ra l�i</h3><p>${esc(e.message)}</p><a class="btn btn-outline" href="#/">Về trang chủ</a></div>`); }
      return;
    }
  }
  $('#app').innerHTML = webShell(`<div class="surface empty-state container"><h3>404 — Không tìm thấy trang</h3><a class="btn" href="#/">Về trang chủ</a></div>`);
}
window.addEventListener('hashchange', render);
const $ = (s) => document.querySelector(s);

/** Render sau khi chắc chắn đã có phiên (test mode tự �Ēng nhập) */
async function boot() {
  await ensureTestSession();
  render();
}
window.addEventListener('DOMContentLoaded', boot);
if (document.readyState !== 'loading') boot();

