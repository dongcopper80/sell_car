    <p class="tiny muted" style="margin-top:10px">Prototype chưa kết n�i VNeID — thao tác chưa xác thực phiên �Ēng nhập.</p>
    <div class="divider"></div>
    <div class="notice"><strong>Đại diện doanh nghiếp?</strong><p class="tiny" style="margin:4px 0 0">Tài khoản doanh nghiếp được Aoto tạo thủ công sau khi nhận và xác minh hồ sơ (giấy phép kinh doanh, mã s� thuế, tài khoản ngân hàng, người �ại diện).</p></div>
  </div></div>`);
});

route('/account', async () => {
  if (!state.token) return navigate('#/auth');
  const me = state.user?.id ? await api('/auth/me').catch(() => state.user) : state.user;
  $('#app').innerHTML = webShell(`<div class="container"><div class="page-heading"><div><span class="eyebrow">Tài khoản</span><h1>Xin chào, ${esc(me.fullName || me.email)}</h1></div></div>
    <div class="grid grid-3">
      <div class="kpi"><div class="kpi-top"><span>Vai trò</span><span class="kpi-icon">${icon('user')}</span></div><strong>${esc(me.role)}</strong></div>
      <div class="kpi"><div class="kpi-top"><span>Đ�9nh danh</span><span class="kpi-icon">${icon('shield')}</span></div><strong>${me.identityVerified ? 'Đã xác thực' : 'Chưa'}</strong></div>
      <div class="kpi"><div class="kpi-top"><span>Tin �Ēng</span><span class="kpi-icon">${icon('eye')}</span></div><strong><a href="#/my-listings" style="color:var(--green-800)">Xem danh sách</a></strong></div>
    </div></div>`);
});

route('/my-listings', async () => {
