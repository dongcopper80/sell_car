/**
 * OtoChinhChu web + CMS — SPA render theo cấu trúc HTML của prototype (c:\Projects\oto).
 * Gọi API NestJS tại API_BASE. Bản này dùng cho cả web (index) và CMS (cms.js).
 */
const API_BASE = localStorage.getItem('aoto_api') || 'http://localhost:3000/api/v1';

/**
 * TEST MODE: tự �Ēng nhập bằng tài khoản admin �Ồ test toàn bợ chức nĒng
 * mà không cần thao tác �Ēng nhập. Tắt: localStorage.setItem('aoto_test_mode','0')
 */
const USE_TEST_MODE = localStorage.getItem('aoto_test_mode') !== '0';
const TEST_ACCOUNT = { email: 'admin@otochinhchu.vn', password: 'admin123' };

const state = {
  token: localStorage.getItem('aoto_token') || null,
  user: JSON.parse(localStorage.getItem('aoto_user') || 'null'),
};

