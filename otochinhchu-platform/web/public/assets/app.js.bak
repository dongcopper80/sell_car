function renderCmsLogin() {
  $('#app').innerHTML = `<div class="auth-container"><div class="auth-card surface surface-pad" style="max-width:420px;margin:60px auto">
    <span class="eyebrow">Quản trị</span><h1 style="font-size:26px">CMS Đăng nhập</h1>
    <p class="muted tiny">Tài khoản doanh nghiếp chỉ được tạo từ CMS sau khi ��i chiếu hồ sơ.</p>
    <form id="cms-login"><div class="field"><label>Email</label><input name="email" type="email" required></div>
    <div class="field"><label>Mật khẩu</label><input name="password" type="password" required></div>
    <button class="btn" style="width:100%;margin-top:14px">Đăng nhập</button></form>
    <p class="tiny muted" style="margin-top:12px"><a href="#/" style="color:var(--green-800)">� � Về website</a></p>
  </div></div>`;
  $('#cms-login').onsubmit = async (e) => {
    e.preventDefault();
    const f = Object.fromEntries(new FormData(e.target));
    try {
      const res = await api('/auth/login', { method: 'POST', body: f });
      state.token = res.accessToken; state.user = res.user;
      localStorage.setItem('aoto_token', res.accessToken); localStorage.setItem('aoto_user', JSON.stringify(res.user));
      navigate('#/cms'); render();
    } catch (err) { toast(err.message, 'error'); }
  };
}

/* ---------- shared widgets ---------- */
const kpiCard = (label, value, sub, ico) => `<div class="kpi"><div class="kpi-top"><span>${esc(label)}</span><span class="kpi-icon">${icon(ico || 'chart')}</span></div><strong>${esc(value)}</strong><span class="tiny muted">${esc(sub || '')}</span></div>`;

const photoFallback = (v) => `data:image/svg+xml;utf8,${encodeURIComponent(`<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 640 400'><rect width='640' height='400' fill='#e6efe9'/><g fill='none' stroke='#9dbfab' stroke-width='10'><rect x='150' y='150' width='340' height='110' rx='30'/><circle cx='215' cy='280' r='32' fill='#fff'/><circle cx='425' cy='280' r='32' fill='#fff'/><path d='M180 160l40-40h200l40 40'/></g><text x='320' y='360' text-anchor='middle' font-family='Segoe UI' font-size='26' fill='#5d7a68'>OtoChinhChu</text></svg>`).replace(/'/g, '%27')}`;

function vehicleCard(v) {
  const sellerTypeLabel = v.sellerType === 'business' ? 'Salon' : 'Cá nhân';
  return `<article class="vehicle-card">
    <a href="#/vehicle/${v.id}" class="vehicle-photo">
      <img src="${esc((v.photos && v.photos[0]) || '')}" alt="${esc(v.title)}" loading="lazy"
        onerror="this.onerror=null;this.src='${photoFallback(v)}'">
      <span class="photo-tag"><span class="status ${v.verified ? 'status-verified' : ''}">${v.verified ? 'Đã xác minh' : esc(sellerTypeLabel)}</span></span>
    </a>
    <div class="vehicle-info">
      <h3><a href="#/vehicle/${v.id}">${esc(v.title)}</a></h3>
      <p class="vehicle-price">${vnd(v.priceVnd)}</p>
      <p class="vehicle-meta"><span>${esc(v.year)}</span><span>${Number(v.odometerKm).toLocaleString('vi-VN')} km</span><span>${esc(v.fuelType === 'petrol' ? 'Xăng' : v.fuelType === 'diesel' ? 'Diesel' : v.fuelType)}</span><span>${esc(v.transmission === 'automatic' ? 'Tự động' : 'S� sàn')}</span></p>
      <p class="vehicle-location">${icon('pin')} ${esc(v.location)}</p>
      <div class="card-foot"><span class="seller-mini"><span class="avatar">${esc(initials(v.title))}</span> ${esc(sellerTypeLabel)}</span>
        <a class="btn btn-outline btn-sm" href="#/vehicle/${v.id}">Xem chi tiết</a></div>
    </div></article>`;
}

