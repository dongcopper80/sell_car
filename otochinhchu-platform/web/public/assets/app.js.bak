    <section class="hero">
      <div class="hero-content">
        <span class="eyebrow">Mua bán xe chính chủ</span>
        <h1>Tìm chiếc xe phù hợp, giao dịch an tâm</h1>
        <p>Tin �Ēng được kiểm duyệt. Cá nhân định danh qua VNeID, doanh nghiếp xác minh hồ sơ �ầy đủ.</p>
        <form class="search-panel" data-action="hero-search">
          <input name="keyword" placeholder="Tìm theo tên xe..." aria-label="Từ khóa">
          <select name="fuelType"><option value="">Nhiên liệu</option><option value="petrol">Xăng</option><option value="diesel">Diesel</option><option value="electric">Đi�!n</option><option value="hybrid">Hybrid</option></select>
          <select name="transmission"><option value="">Hợp s�</option><option value="automatic">Tự động</option><option value="manual">S� sàn</option></select>
          <button class="btn">${icon('search')} Tìm xe</button>
        </form>
        <div class="trust-row"><span>${icon('shield')} Tin �Ēng xác minh</span><span>${icon('check')} Đặt cọc có ��i soát</span><span>${icon('clock')} Cập nhật liên tục</span></div>
      </div>
    </section>
    <div class="container">
      <section class="section"><div class="section-head"><div><span class="eyebrow">M�:i nhất</span><h2>Xe �ang bán</h2></div><a class="btn btn-outline btn-sm" href="#/search">Xem tất cả ${icon('arrow')}</a></div>
        <div class="grid grid-4">${items.map(vehicleCard).join('') || `<div class="surface empty-state" style="grid-column:1/-1"><h3>Chưa có tin �Ēng</h3><p>Dữ liệu sẽ xuất hi�!n sau khi seed.</p></div>`}</div>
      </section>
      ${makeList.length ? `<section class="section"><div class="section-head"><div><span class="eyebrow">Thương hi�!u</span><h2>Tìm theo hãng</h2></div></div>
        <div class="brand-strip">${makeList.slice(0, 8).map((mk) => `<a class="brand-tile" href="#/search?make=${esc(mk.code)}"><span class="brand-symbol">${esc((mk.name || '?')[0])}</span>${esc(mk.name)}</a>`).join('')}</div>
      </section>` : ''}
    </div>`, 'home');
});

route('/search', async (_p, params) => {
  const qs = new URLSearchParams(params);
  qs.set('pageSize', '24');
  const data = await api(`/vehicles?${qs}`);
  const items = data.items || data;
  $('#app').innerHTML = webShell(`
    <div class="container"><div class="page-heading"><div><span class="eyebrow">Kết quả</span><h1>${data.total ?? items.length} xe phù hợp</h1></div></div>
      <form class="search-panel" style="margin:0 auto 22px;grid-template-columns:1.2fr 1fr 1fr auto" data-action="hero-search">
        <input name="keyword" placeholder="Tìm theo tên xe..." value="${esc(params.get('keyword') || '')}">
        <select name="fuelType"><option value="">Nhiên liệu</option>${['petrol', 'diesel', 'electric', 'hybrid'].map((f) => `<option ${params.get('fuelType') === f ? 'selected' : ''}>${f}</option>`).join('')}</select>
        <select name="transmission"><option value="">Hợp s�</option>${['automatic', 'manual'].map((t) => `<option ${params.get('transmission') === t ? 'selected' : ''}>${t}</option>`).join('')}</select>
        <button class="btn">${icon('search')} Lọc</button>
      </form>
      <div class="grid grid-4">${items.map(vehicleCard).join('') || `<div class="surface empty-state" style="grid-column:1/-1"><div class="empty-icon">${icon('search')}</div><h3>Không có xe kh�:p</h3><p>Thử bỏ bất �iều ki�!n lọc.</p></div>`}</div>
    </div>`, 'search');
});

route('/vehicle/:id', async (p) => {
  const v = await api(`/vehicles/${p.id}`);
  const specs = [
    ['NĒm sản xuất', v.year], ['Đã �i', `${Number(v.odometerKm).toLocaleString('vi-VN')} km`],
    ['Nhiên liệu', v.fuelType === 'petrol' ? 'Xăng' : v.fuelType], ['Hợp s�', v.transmission === 'automatic' ? 'Tự động' : 'S� sàn'],
    ['Khu vực', v.location], ['Người bán', v.sellerType === 'business' ? 'Salon (đã xác minh)' : 'Cá nhân'],
  ];
  $('#app').innerHTML = webShell(`
    <div class="container"><div class="detail-layout">
      <section class="surface surface-pad">
        <span class="eyebrow">${v.sellerType === 'business' ? 'Salon' : 'Người bán cá nhân'}</span>
        <h1 style="font-size:28px">${esc(v.title)}</h1>
        <p class="vehicle-price" style="font-size:26px">${vnd(v.priceVnd)}</p>
        ${statusBadge(v.status)}
        <div class="divider"></div>
        ${(v.photos && v.photos.length) ? `<img class="detail-main-photo" src="${esc(v.photos[0])}" alt="${esc(v.title)}" onerror="this.onerror=null;this.src='${photoFallback(v)}'">` : ''}
        <div class="detail-specs" style="margin-top:16px">${specs.map(([k, val]) => `<div class="spec"><span>${esc(k)}</span><strong>${esc(val)}</strong></div>`).join('')}</div>
        <div class="divider"></div>
        <p style="white-space:pre-wrap">${esc(v.description || 'Chưa có mô tả.')}</p>
      </section>
      <aside class="surface surface-pad seller-panel">
        <div class="seller-profile-head"><span class="avatar">${esc(initials(v.title))}</span>
          <div><h3>${v.sellerType === 'business' ? 'Showroom' : 'Người bán'}</h3><p class="tiny muted">${esc(v.location)}</p></div></div>
        <div class="divider"></div>
        <button class="btn" style="width:100%" data-action="deposit" data-id="${esc(v.id)}">${icon('check')} Đặt cọc xe này</button>
        <p class="tiny muted" style="margin-top:10px">Tiền đặt cọc được ��i soát bi Aoto trước khi xác nhận.</p>
      </aside>
    </div></div>`);
});

/* ---------- AUTH: chỉ VNeID ---------- */
